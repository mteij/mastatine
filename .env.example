# ---- Production (docker compose reads these from .env) ----

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=change-me

# Public origin of the site, https, no trailing slash. Used for sign-in and unsubscribe links.
SITE_URL=https://mastatine.nl

# Secret for signing sessions and newsletter tokens. Generate with: openssl rand -base64 32
# Rotating it signs everyone out and invalidates outstanding unsubscribe links.
BETTER_AUTH_SECRET=

# Comma-separated emails that become admins the first time they sign in with a magic link.
ADMIN_EMAILS=you@example.com

# Purelymail SMTP (use a dedicated mailbox; 465 = implicit TLS, 587 = STARTTLS).
SMTP_HOST=smtp.purelymail.com
SMTP_PORT=465
SMTP_USER=hello@mastatine.nl
SMTP_PASS=
MAIL_FROM="S.A. Mastatine <hello@mastatine.nl>"
MAIL_REPLY_TO=
# Shown in email footers and on /contact.
CONTACT_EMAIL=hello@mastatine.nl

# Merch shop destination (Printify Pop-Up Store or similar). Inlined at build time.
NEXT_PUBLIC_SHOP_URL=https://your-shop.printify.me

# ---- Local development (.env.local) ----
# DATABASE_URL=postgresql://mastatine:dev@127.0.0.1:5432/mastatine
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=any-long-random-string
# MAIL_TRANSPORT=log        # print emails (incl. sign-in links) instead of sending; never in production
# UPLOAD_DIR=./uploads
# DEV_ALLOWED_ORIGINS=      # extra hosts allowed to reach the dev server, e.g. a Tailscale IP
