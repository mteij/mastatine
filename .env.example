# PostgreSQL connection string — Supabase dashboard → Settings → Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Anon (public) key — Supabase dashboard → Settings → API → anon (public)
SUPABASE_ANON_KEY=your-anon-key-here

# Merch shop destination — link to the Printify Pop-Up Store (or Spreadshop) storefront.
# Leave unset to show a "coming soon" state on /shop.
NEXT_PUBLIC_SHOP_URL=https://your-shop.printify.me
