{
  "name": "mastatine",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "next dev",
    "build": "bun --bun next build",
    "lint": "eslint",
    "db:dev": "POSTGRES_PASSWORD=dev docker compose -f docker-compose.yml -f compose.dev.yaml up -d --wait db && DATABASE_URL=postgresql://mastatine:dev@127.0.0.1:5432/mastatine bun scripts/migrate.mjs",
    "db:migrate": "bun scripts/migrate.mjs",
    "db:dev:local": "bun scripts/dev-db.mjs"
  },
  "dependencies": {
    "bad-words": "^4.1.5",
    "better-auth": "^1.7.15",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "postgres": "^4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4.3.4",
    "typescript": "^6"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "minimatch": "^11.0.1"
  }
}
